local currentZapSound = nil

-- SETTINGS SYSTEM
local saveFile = "cyber_settings.json"
local settings = {
    muteButtonSounds = false,
    autoSave = false,
    clickMode = false
}

if isfile and readfile and isfile(saveFile) then
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(saveFile))
    end)
    if success and data then
        settings.muteButtonSounds = data.muteButtonSounds or false
        settings.autoSave = data.autoSave or false
        settings.clickMode = data.clickMode or false
    end
end

local function saveSettings()
    if not settings.autoSave then return end
    local data = HttpService:JSONEncode(settings)
    if writefile then
        pcall(function()
            writefile(saveFile, data)
        end)
    end
end

local function playRandomZap(volume)
    if settings.muteButtonSounds then return end
    if currentZapSound then currentZapSound:Stop() end
    local randomId = zapIds[math.random(1, #zapIds)]
    pcall(function()
        currentZapSound = Instance.new("Sound")
        currentZapSound.SoundId = randomId
        currentZapSound.Volume = volume or 0.5
        currentZapSound.Parent = SoundService
        currentZapSound:Play()
        currentZapSound.Ended:Connect(function()
            currentZapSound:Destroy()
        end)
    end)
end

-- GET HRP / HUMANOID
local function getHRP()
    local char = player.Character
    if not char then char = player.CharacterAdded:Wait() end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    if not hrp then
        hrp = char:WaitForChild("HumanoidRootPart", 10) or char:WaitForChild("Torso", 10)
    end
    return hrp
end

local function getHumanoid()
    local char = player.Character
    if not char then char = player.CharacterAdded:Wait() end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then hum = char:WaitForChild("Humanoid", 10) end
    return hum
end

-- UI HELPERS
local function createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 12)
    corner.Parent = parent
    return corner
end

local function createStroke(parent, thickness, color)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 2
    stroke.Color = color or Color3.fromRGB(255, 0, 0)
    stroke.Transparency = 0.5
    stroke.Parent = parent
    return stroke
end

local function createGradient(parent, color1, color2)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, color1 or Color3.fromRGB(20, 0, 40)),
        ColorSequenceKeypoint.new(1, color2 or Color3.fromRGB(80, 0, 120))
    }
    gradient.Rotation = 45
    gradient.Parent = parent
    return gradient
end

local function tweenStroke(stroke, color, transparency)
    TweenService:Create(stroke, TweenInfo.new(0.3), {Color = color, Transparency = transparency}):Play()
end

