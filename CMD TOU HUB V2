            writefile(saveFile, data)
        end)
    end
end

-- Play Zap (เช็ค mute)
local function playRandomZap(volume)
    if settings.muteButtonSounds then return end
    if currentZapSound then currentZapSound:Stop() end
    local randomId = zapIds[math.random(1, #zapIds)]
    currentZapSound = Instance.new("Sound")
    currentZapSound.SoundId = randomId
    currentZapSound.Volume = volume or 0.5
    currentZapSound.Parent = SoundService
    currentZapSound:Play()
    currentZapSound.Ended:Connect(function()
        currentZapSound:Destroy()
    end)
end

-- ฟังก์ชันช่วย
local function getHRP()
    return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    return player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
end

local function createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 12)
    corner.Parent = parent
    return corner
end

local function createStroke(parent, thickness, color)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 2
    stroke.Color = color or Color3.fromRGB(255, 0, 0)
    stroke.Transparency = 0.5
    stroke.Parent = parent
    return stroke
end

local function createGradient(parent, color1, color2)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, color1 or Color3.fromRGB(20, 0, 40)),
        ColorSequenceKeypoint.new(1, color2 or Color3.fromRGB(80, 0, 120))
    }
    gradient.Rotation = 45
    gradient.Parent = parent
    return gradient
end

local function tweenStroke(stroke, color, transparency)
    TweenService:Create(stroke, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Color = color,
        Transparency = transparency
    }):Play()
end

