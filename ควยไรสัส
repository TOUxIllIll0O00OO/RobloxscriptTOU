local function uploadToPastebin(name, code)
    local ok, result = pcall(function()
        return HttpService:PostAsync(
            "https://pastebin.com/api/api_post.php",
            "v06-4yrb8uMquN4tMXCm231cegzmvrK5" .. PASTEBIN_API_KEY ..
            "&api_option=paste" ..
            "&api_paste_name=" .. HttpService:UrlEncode(name) ..
            "&api_paste_code=" .. HttpService:UrlEncode(code) ..
            "&api_paste_private=0" ..
            "&api_paste_expire_date=N",
            Enum.HttpContentType.ApplicationUrlEncoded
        )
    end)
    if ok then return result else return nil end
end

local function fetchFromPastebin(key)
    local ok, result = pcall(function()
        return HttpService:GetAsync("https://pastebin.com/raw/" .. key)
    end)
    if ok then return result else return nil end
end

