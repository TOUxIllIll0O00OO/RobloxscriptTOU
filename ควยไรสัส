-- ตกลง → อัพ Pastebin
confirmBtn.MouseButton1Click:Connect(function()
    local sName = nameBox.Text
    local sDesc = descBox.Text
    local sCode = codeBox.Text
    if sName == "" or sCode == "" then
        statusLabel.Text = "กรอกชื่อและโค้ดด้วยครับ!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end

    statusLabel.Text = "กำลังอัพโหลด..."
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 100)

    task.spawn(function()
        -- รวม metadata กับโค้ดไว้ใน paste เดียว
        local fullContent = "##NAME##" .. sName .. "##DESC##" .. sDesc .. "##CODE##" .. sCode
        local result = uploadToPastebin(sName, fullContent)

        if result and result:find("pastebin.com/") then
            local pasteKey = result:match("pastebin%.com/(.+)$"):gsub("%s+", "")
            statusLabel.Text = "Key: " .. pasteKey .. " (แชร์ให้เพื่อน)"
            statusLabel.TextColor3 = Color3.fromRGB(100, 200, 100)
            createScriptButton(sName, sDesc, sCode)
            task.delay(3, function()
                addScriptGui.Visible = false
            end)
        else
            statusLabel.Text = "อัพโหลดไม่สำเร็จ ลองใหม่ครับ"
            statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        end
    end)
end)

-- ดึง script จาก Paste Key
fetchBtn.MouseButton1Click:Connect(function()
    local key = fetchBox.Text:gsub("%s+", "")
    if key == "" then return end

    task.spawn(function()
        local raw = fetchFromPastebin(key)
        if raw then
            local sName = raw:match("##NAME##(.-)##DESC##") or "ไม่มีชื่อ"
            local sDesc = raw:match("##DESC##(.-)##CODE##") or ""
            local sCode = raw:match("##CODE##(.+)$") or raw
            createScriptButton(sName, sDesc, sCode)
            fetchBox.Text = ""
        end
    end)
end)

