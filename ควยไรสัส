local function makeRow(parent, labelText, defaultVal, posY, onConfirm)
    local label = Instance.new("TextLabel", parent)
    label.Size = UDim2.new(0, 110, 0, 32)
    label.Position = UDim2.new(0, 10, 0, posY)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(40, 40, 40)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left

    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(0, 80, 0, 32)
    box.Position = UDim2.new(0, 125, 0, posY)
    box.BackgroundColor3 = Color3.fromRGB(210, 210, 210)
    box.Text = defaultVal
    box.Font = Enum.Font.Gotham
    box.TextSize = 13
    box.BorderSizePixel = 0
    Instance.new("UICorner", box)

    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(0, 60, 0, 32)
    btn.Position = UDim2.new(0, 215, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
    btn.Text = "ตกลง"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        local val = tonumber(box.Text)
        if val then
            onConfirm(val)
            btn.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
            task.delay(0.5, function() btn.BackgroundColor3 = Color3.fromRGB(100, 200, 100) end)
        else
            box.TextColor3 = Color3.fromRGB(255, 80, 80)
            task.delay(0.5, function()
                box.TextColor3 = Color3.fromRGB(50, 50, 50)
                box.Text = defaultVal
            end)
        end
    end)
end

