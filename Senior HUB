task.spawn(function()
    while true do
        if _G.V2Shoot then
            pcall(function()
                local t = getBestTarget()
                if t and t.Character and t.Character:FindFirstChild(_G.AimPart) then
                    local pos = t.Character[_G.AimPart].Position + (t.Character[_G.AimPart].Velocity * 0.16)
                    local guns = {}
                    for _, tool in pairs(Player.Backpack:GetChildren()) do if tool.Name == "Gun" then table.insert(guns, tool) end end
                    local step = (_G.V2Mode == "2 กระบอก") and 2 or 1
                    for i = 1, #guns, step do
                        if not _G.V2Shoot then break end
                        local g1, g2 = guns[i], guns[i+1]
                        if g1 then g1.Parent = Player.Character end if g2 then g2.Parent = Player.Character end
                        if g1 and g1:FindFirstChild("shot") then g1.shot:FireServer(pos) end 
                        if g2 and g2:FindFirstChild("shot") then g2.shot:FireServer(pos) end
                        task.wait(_G.FastFireDelay)
                        if g1 then g1.Parent = Player.Backpack end if g2 then g2.Parent = Player.Backpack end
                    end
                end
            end)
        end
        task.wait(0.0001)
    end
end)

