-- Logic 🧠
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TargetPos = Vector3.new(89.44, 176.45, 244.02)

-- ฟังก์ชันหยิบ Tool 📦
GetToolBtn.MouseButton1Click:Connect(function()
    local closestCD = nil
    local minDistance = math.huge
    
    -- ค้นหา ClickDetector ที่ใกล้พิกัดเป้าหมายที่สุด
    for _, v in pairs(game:GetDescendants()) do
        if v:IsA("ClickDetector") then
            local part = v.Parent
            if part and part:IsA("BasePart") then
                local dist = (part.Position - TargetPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    closestCD = v
                end
            end
        end
    end
    
    if closestCD then
        fireclickdetector(closestCD) -- กด ClickDetector ทันที ⚡
        print("กด ClickDetector เรียบร้อย! 😈")
    else
        warn("ไม่พบ ClickDetector ในบริเวณนั้น! ❌")
    end
end)

-- ฟังก์ชันทำเซิร์ฟเน่า 🔥
ExecuteBtn.MouseButton1Click:Connect(function()
    local amount = tonumber(AmountInput.Text)
    if not amount then return end
    
    local character = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    local tool = backpack:FindFirstChild("Fireflies") or (character and character:FindFirstChild("Fireflies"))
    
    if tool then
        -- ถือ Tool ทันที 🛠️
        tool.Parent = character
        
        local remote = tool:WaitForChild("RemoteEvent")
        
        -- รันรีโมทรัวๆ ตามจำนวน ⚙️🔥
        for i = 1, amount do
            remote:FireServer()
        end
        
        -- เก็บ Tool ทันทีหลังรันครบ 📦
        tool.Parent = backpack
    else
        warn("ไม่พบ Fireflies ในกระเป๋าหรือตัวละคร! ❌")
    end
end)
