-- 🎯 ฟังก์ชันหลัก
local function equipMP5()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    
    if character and backpack then
        local mp5 = backpack:FindFirstChild("MP5")
        if mp5 and mp5:IsA("Tool") then
            character.Humanoid:EquipTool(mp5)
            wait(0.1)
            return true
        end
        
        local mp5InHand = character:FindFirstChild("MP5")
        if mp5InHand then
            return true
        end
    end
    return false
end

local function unequipMP5()
    local character = LocalPlayer.Character
    if character then
        character.Humanoid:UnequipTools()
    end
end

local function executePlayer(targetPlayer)
    if targetPlayer.Character then
        local args = {"execute", targetPlayer.Character}
        KnockEvent:FireServer(unpack(args))
    end
end

local function shootMP5(targetPlayer)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    
    if not character then return end
    
    local mp5 = character:FindFirstChild("MP5") or backpack:FindFirstChild("MP5")
    if not mp5 then return end

    local targetCharacter = targetPlayer.Character
    if not targetCharacter then return end
    
    local humanoid = targetCharacter:FindFirstChild("Humanoid")
    local leftHand = targetCharacter:FindFirstChild("LeftHand")
    
    if humanoid and leftHand and humanoid.Health > 15 then
        local args = {
            mp5,
            {
                p = leftHand.Position,
                pid = 1,
                part = leftHand,
                d = 5.8974432945251465,
                maxDist = 5.746327877044678,
                h = humanoid,
                m = Enum.Material.SmoothPlastic,
                n = Vector3.new(-0.9466334581375122, 0.269170880317688, -0.17729204893112183),
                t = 0.0934435870284259,
                sid = 226
            }
        }
        
        WeaponsSystem:WaitForChild("Network"):WaitForChild("WeaponHit"):FireServer(unpack(args))
    end
end

local function killAllPlayers()
    if not equipMP5() then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character then
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 15 then
                    while humanoid.Health > 15 do
                        shootMP5(player)
                        wait(0.1)
                    end
                    
                    wait(0.2)
                    executePlayer(player)
                    wait(0.1)
                end
            end
        end
    end
    
    wait(0.2)
    unequipMP5()
end

local function revivePlayer(targetPlayer)
    local args = {"revive", targetPlayer.Character}
    KnockEvent:FireServer(unpack(args))
end

local function reviveAllPlayers()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            revivePlayer(player)
            wait(0.05)
        end
    end
end

local function infiniteAmmo()
    if infiniteAmmoLoop then
        infiniteAmmoLoop:Disconnect()
        infiniteAmmoLoop = nil
    end
    
    if infiniteAmmoEnabled then
        infiniteAmmoLoop = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            local backpack = LocalPlayer.Backpack
            
            if character or backpack then
                local mp5 = (character and character:FindFirstChild("MP5")) or (backpack and backpack:FindFirstChild("MP5"))
                if mp5 then
                    local args = { mp5 }
                    WeaponsSystem:WaitForChild("Network"):WaitForChild("WeaponReloadRequest"):FireServer(unpack(args))
                end
            end
            wait(0.1)
        end)
    end
end

local function autoFarmMoney()
    if autoFarmLoop then
        autoFarmLoop:Disconnect()
        autoFarmLoop = nil
    end
    
    if autoFarmMoneyEnabled then
        autoFarmLoop = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return end
            
            local hrp = character.HumanoidRootPart
            
            local moneyDrops = workspace:FindFirstChild("MoneyDrops")
            if moneyDrops then
                for _, moneyDrop in pairs(moneyDrops:GetChildren()) do
                    if moneyDrop:IsA("Model") and moneyDrop:FindFirstChild("Money") then
                        local moneyPart = moneyDrop:FindFirstChild("Money")
                        if moneyPart and moneyPart:FindFirstChild("ProximityPrompt") then
                            local proximityPrompt = moneyPart.ProximityPrompt
                            
                            local originalPosition = hrp.CFrame
                            
                            hrp.CFrame = moneyPart.CFrame
                            wait(0.15)
                            
                            fireproximityprompt(proximityPrompt)
                            wait(0.15)
                            
                            hrp.CFrame = originalPosition
                            wait(0.1)
                        end
                    end
                end
            end
            
            wait(0.5)
        end)
    end
end

