    jumpEnabled = not jumpEnabled
    JumpToggle.Text = jumpEnabled and "เปิด" or "ปิด"
    JumpToggle.BackgroundColor3 = jumpEnabled and Color3.fromRGB(0,140,0) or Color3.fromRGB(50,50,50)
    JumpToggle.TextColor3 = jumpEnabled and Color3.fromRGB(255,255,255) or Color3.fromRGB(200,50,50)
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if speedEnabled then humanoid.WalkSpeed = desiredSpeed end
    if jumpEnabled then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = desiredJump
        humanoid.JumpHeight = desiredJump
    end
end)

