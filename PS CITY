    local num = tonumber(SpeedInput.Text)
    if num and num > 0 then desiredSpeed = num else SpeedInput.Text = tostring(desiredSpeed) end
end)

JumpInput.FocusLost:Connect(function()
    local num = tonumber(JumpInput.Text)
    if num and num > 0 then desiredJump = num else JumpInput.Text = tostring(desiredJump) end
end)

