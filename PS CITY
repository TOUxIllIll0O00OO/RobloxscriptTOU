local currentTab = "Home"
local function switchTab(tabName)
    if tabName == currentTab then return end
    HomePage.Visible = false
    SettingsPage.Visible = false
    ShopPage.Visible = false
    PlayerPage.Visible = false
    FarmPage.Visible = false
    
    if tabName == "Home" then HomePage.Visible = true
    elseif tabName == "Settings" then SettingsPage.Visible = true
    elseif tabName == "Shop" then ShopPage.Visible = true
    elseif tabName == "Player" then PlayerPage.Visible = true
    elseif tabName == "Farm" then FarmPage.Visible = true end
    
    currentTab = tabName
end

