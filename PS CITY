local currentTab = "Home"
local function switchTab(tabName)
    if tabName == currentTab then return end
    HomePage.Visible = false
    GriefPage.Visible = false
    ShopPage.Visible = false
    PlayerPage.Visible = false
    FarmPage.Visible = false
    SettingsPage.Visible = false
    
    HomeTabBtn.BackgroundColor3 = Color3.fromRGB(20,20,20) HomeTabBtn.TextColor3 = Color3.fromRGB(200,200,200)
    GriefTabBtn.BackgroundColor3 = Color3.fromRGB(20,20,20) GriefTabBtn.TextColor3 = Color3.fromRGB(200,200,200)
    ShopTabBtn.BackgroundColor3 = Color3.fromRGB(20,20,20) ShopTabBtn.TextColor3 = Color3.fromRGB(200,200,200)
    PlayerTabBtn.BackgroundColor3 = Color3.fromRGB(20,20,20) PlayerTabBtn.TextColor3 = Color3.fromRGB(200,200,200)
    FarmTabBtn.BackgroundColor3 = Color3.fromRGB(20,20,20) FarmTabBtn.TextColor3 = Color3.fromRGB(200,200,200)
    SettingsTabBtn.BackgroundColor3 = Color3.fromRGB(20,20,20) SettingsTabBtn.TextColor3 = Color3.fromRGB(200,200,200)
    
    if tabName == "Home" then HomePage.Visible = true HomeTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) HomeTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    elseif tabName == "Grief" then GriefPage.Visible = true GriefTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) GriefTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    elseif tabName == "Shop" then ShopPage.Visible = true ShopTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) ShopTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    elseif tabName == "Player" then PlayerPage.Visible = true PlayerTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) PlayerTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    elseif tabName == "Farm" then FarmPage.Visible = true FarmTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) FarmTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    elseif tabName == "Settings" then SettingsPage.Visible = true SettingsTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) SettingsTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    end
    
    currentTab = tabName
end

