-- Remote Finder
local function getMeleeRemote()
    return ReplicatedStorage:FindFirstChild("Assets", true) 
        and ReplicatedStorage.Assets:FindFirstChild("Remotes", true) 
        and ReplicatedStorage.Assets.Remotes:FindFirstChild("meleeHit")
end

-- [CORE LOGIC] Instant Attack Batch
local function attackTargetBatch(targetChar)
    if not targetChar or not targetChar:FindFirstChild("Humanoid") then return false end
    local hum = targetChar.Humanoid
    local char = player.Character
    local tool = char and char:FindFirstChildWhichIsA("Tool") or player.Backpack:FindFirstChildWhichIsA("Tool")
    local remote = getMeleeRemote()
    
    if tool and remote and hum.Health > 0 then
        for i = 1, 10 do
            if hum.Health > 0 then 
                pcall(function() remote:FireServer(tool, hum, 1) end) 
            else 
                return true
            end
        end
    end
    return hum.Health <= 0
end

