-- [SYSTEM LOOPS]
RunService.Heartbeat:Connect(function()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    
    if root and hum then
        if speedEnabled then hum.WalkSpeed = walkSpeedValue end
        if espEnabled then
            AuraCircle.Parent = workspace
            AuraCircle.CFrame = (root.CFrame * CFrame.new(0, -2.8, 0)) * CFrame.Angles(0, 0, math.rad(90))
            AuraCircle.Size = Vector3.new(0.02, killRange * 2, killRange * 2)
        else
            AuraCircle.Parent = nil
        end

        if auraEnabled and not isAssassinating then
            local targetFound = false
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
                    local targetHum = p.Character.Humanoid
                    local dist = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if dist <= killRange and targetHum.Health > 0 then
                        targetFound = true
                        if not char:FindFirstChildWhichIsA("Tool") then
                            local t = player.Backpack:FindFirstChildWhichIsA("Tool")
                            if t then hum:EquipTool(t) end
                        end
                        local isDead = attackTargetBatch(p.Character)
                        if isDead then
                            if char:FindFirstChildWhichIsA("Tool") then hum:UnequipTools() end
                            targetFound = false
                        end
                        task.wait(0.05)
                    end
                end
            end
            if not targetFound and char:FindFirstChildWhichIsA("Tool") then hum:UnequipTools() end
        end
    end
end)

-- Click Warp Kill Logic
mouse.Button1Down:Connect(function()
    if clickKillEnabled and not isAssassinating and mouse.Target then
        local model = mouse.Target:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") and Players:GetPlayerFromCharacter(model) ~= player then
            isAssassinating = true
            local originalPos = player.Character.HumanoidRootPart.CFrame
            local tool = player.Character:FindFirstChildWhichIsA("Tool") or player.Backpack:FindFirstChildWhichIsA("Tool")
            if tool then
                player.Character.Humanoid:EquipTool(tool)
                task.wait(0.1)
                player.Character:PivotTo(model.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2))
                local sTime = tick()
                while model and model.Humanoid.Health > 0 and clickKillEnabled and (tick()-sTime < 5) do
                    attackTargetBatch(model)
                    player.Character:PivotTo(model.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2))
                    task.wait(0.1)
                end
                player.Character:PivotTo(originalPos)
                player.Character.Humanoid:UnequipTools()
            end
            isAssassinating = false
        end
    end
end)

