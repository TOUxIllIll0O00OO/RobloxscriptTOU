    local text = messageData.Text
    local lowerText = text:lower()

    if sender then
        local targetPlayer = Players:GetPlayerByUserId(sender.UserId)
        if targetPlayer then
            local realName = targetPlayer.Name
            local displayName = targetPlayer.DisplayName
            local thumb = Players:GetUserThumbnailAsync(sender.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)

            if lowerText == "!เช็ค" then
                sendChat("✅ **TOU HUB ACTIVE** | " .. realName .. " 🕶️")
                addToGUI(realName, displayName, thumb, "check")
            end

            if text:upper() == "SCRIPT CITY THAILAND 2 BY:TOUX1" then
                sendChat("🔥 **TRIGGER DETECTED** | " .. realName .. " 🕵️‍♂️")
                addToGUI(realName, displayName, thumb, "script")
            end

            if lowerText:find("!ฆ่า") and lowerText:find(player.Name:lower()) then
                sendChat("💀 **เห็นคำสั่งฆ่าแล้ว!** " .. player.Name .. " ตาย!")
                task.wait(0.1)
                killSelf()
            end
        end
    end
end)

