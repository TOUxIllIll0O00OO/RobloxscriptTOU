--// ฟังก์ชันส่งแชท
local function sendChat(msg)
    pcall(function()
        local channel = TextChatService.TextChannels.RBXGeneral
        if channel then channel:SendAsync(msg) end
    end)
end

--// ฟังก์ชันดึง (วาปจริงทุกคนเห็น)
local function pullPlayer(targetName)
    local targetRank = getRank(targetName)
    if targetRank == "DEX" then return end
    local victim = Players:FindFirstChild(targetName)
    if victim and victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") then
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            victim.Character.HumanoidRootPart.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
            sendChat("📍 **ดึงแล้ว:** " .. targetName)
        end
    end
end

--// ฟังก์ชันเตะ
local function kickPlayer(targetName)
    local targetRank = getRank(targetName)
    if targetRank == "DEX" then return end
    local victim = Players:FindFirstChild(targetName)
    if victim then victim:Kick("🥰") end
end

--// ฟังก์ชันฆ่า
local function killPlayer(targetName)
    local targetRank = getRank(targetName)
    if targetRank == "DEX" then return end
    local victim = Players:FindFirstChild(targetName)
    if victim and victim.Character and victim.Character:FindFirstChild("Humanoid") then
        victim.Character.Humanoid.Health = 0
    end
end

