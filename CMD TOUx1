			tool.Parent = player.Backpack
			print("✅ เก็บ Tool เข้ากระเป๋า")
		else
			print("⚠️ ไม่พบ Tool")
		end

		task.wait(0.5)

		pcall(function()
			game:GetService("ReplicatedStorage"):WaitForChild("ToolStorage"):WaitForChild("ToolsStorage"):FireServer("Save", "Duck")
		end)
		print("💾 Save Duck (รอบ "..round..")")

		task.wait(0.5)
	end

	print("🌀 ครบ 10 รอบ! เริ่ม Get Duck 10 ครั้ง...")
	for i = 1, 10 do
		pcall(function()
			game:GetService("ReplicatedStorage"):WaitForChild("ToolStorage"):WaitForChild("ToolsStorage"):FireServer("Get", "Duck")
		end)
		task.wait(0.05)
	end

	print("🎉 ดูปของสำเร็จ!")
end)

