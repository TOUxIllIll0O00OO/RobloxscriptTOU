--// ตรวจจับข้อความ
TextChatService.TextChannels.RBXGeneral.MessageReceived:Connect(function(msgData)
    local text = msgData.Text
    local lower = text:lower()
    local sender = msgData.TextSource
    if not sender then return end
    local p = Players:GetPlayerByUserId(sender.UserId)
    if not p then return end

    local realName = p.Name
    local displayName = p.DisplayName
    local thumb = Players:GetUserThumbnailAsync(sender.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)

    if lower == "!เช็ค" then
        if sender.UserId ~= player.UserId then
            addToGUI(realName, displayName, thumb, "check")
        else
            sendChat("✅ **TOU HUB ACTIVE** | " .. realName .. " 🕶️")
            addToGUI(realName, displayName, thumb, "check")
        end
    end

    if text:upper() == "SCRIPT CITY THAILAND 2 BY:TOUX1" then
        sendChat("🔥 **TRIGGER DETECTED** | " .. realName .. " 🕵️‍♂️")
        addToGUI(realName, displayName, thumb, "script")
    end

    if getRank(player.Name) ~= "DEX" and lower:find("!ฆ่า") and lower:find(player.Name:lower()) then
        sendChat("💀 **โดนคำสั่งฆ่า!** " .. player.Name .. " ตาย!")
        task.wait(0.1)
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.Health = 0
        end
    end

    if myRank == "DEX" and lower:find("!wither") then
        local target = lower:match("!wither%s+(%w+)")
        if target and Players:FindFirstChild(target) then
            sendChat("☠️ **DEX ACTIVATED WITHER:** " .. target .. " ถูกกลืนกิน!")
            witherPlayer(target)
        end
    end
end)

