--// ฟังก์ชันเสกเฉพาะ Duck Tools (กรองชื่อ "Duck")
local function spawnAllDucks()
	print("🦆 เริ่มเสกเป็ด Duck Tools เท่านั้น... กรองแล้ว! 🔍⚡")
	local backpack = player:WaitForChild("Backpack")
	local character = player.Character or player.CharacterAdded:Wait()
	local duckCount = 0

	for _, tool in ipairs(backpack:GetChildren()) do
		if tool:IsA("Tool") and string.find(string.lower(tool.Name), "duck") then
			duckCount = duckCount + 1
			print("🦆 พบ: " .. tool.Name .. " — เสกเลย!")
			
			-- ถือ + ใช้ + เก็บ (ไวสุด)
			tool.Parent = character
			task.defer(function()
				pcall(function()
					tool:Activate()
				end)
			end)
			task.wait(0.05)
			if tool.Parent == character then
				tool.Parent = backpack
			end
		end
	end
	
	print("✅ เสกครบ " .. duckCount .. " ตัวเป็ด Duck แล้ว! 🔥🦆")
end

