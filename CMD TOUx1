--// ฟังก์ชันเช็คยศ
local function getRank(username)
    if table.find(Ranks.DEX, username) then return "DEX" end
    if table.find(Ranks.Premium, username) then return "Premium" end
    if table.find(Ranks.basic, username) then return "basic" end
    return nil
end

