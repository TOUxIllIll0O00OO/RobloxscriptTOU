-- 🔔 Notification System
local function showNotification(message, isSuccess)
    local notif = Instance.new("Frame")
    notif.Name = "Notification"
    notif.Size = UDim2.new(0, 350, 0, 0)
    notif.Position = UDim2.new(0.5, -175, 0, -80)
    notif.AnchorPoint = Vector2.new(0.5, 0)
    notif.BackgroundColor3 = isSuccess and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(255, 80, 80)
    notif.BackgroundTransparency = 0.1
    notif.BorderSizePixel = 0
    notif.Parent = screenGui
    
    local notifCorner = Instance.new("UICorner")
    notifCorner.CornerRadius = UDim.new(0, 12)
    notifCorner.Parent = notif
    
    local notifStroke = Instance.new("UIStroke")
    notifStroke.Color = isSuccess and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 150, 150)
    notifStroke.Thickness = 2
    notifStroke.Transparency = 0.3
    notifStroke.Parent = notif
    
    local notifText = Instance.new("TextLabel")
    notifText.Size = UDim2.new(1, -20, 1, 0)
    notifText.Position = UDim2.new(0, 10, 0, 0)
    notifText.BackgroundTransparency = 1
    notifText.Text = message
    notifText.TextColor3 = Color3.fromRGB(255, 255, 255)
    notifText.TextSize = 16
    notifText.Font = Enum.Font.GothamBold
    notifText.TextWrapped = true
    notifText.Parent = notif
    
    -- Slide In
    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 350, 0, 60),
        Position = UDim2.new(0.5, -175, 0, 20)
    }):Play()
    
    -- Auto Hide
    task.wait(3)
    local slideOut = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, -175, 0, -80),
        Size = UDim2.new(0, 350, 0, 0)
    })
    slideOut:Play()
    slideOut.Completed:Connect(function()
        notif:Destroy()
    end)
end

-- ▶️ Run Button Function
runButton.MouseButton1Click:Connect(function()
    local script = scriptBox.Text
    
    if script == "" or script == "-- 😈 Paste your script here..." then
        showNotification("⚠️ No script to execute!", false)
        return
    end
    
    -- Execute Script
    local success, error = pcall(function()
        loadstring(script)()
    end)
    
    if success then
        showNotification("✅ Script executed successfully!", true)
    else
        showNotification("❌ Script error: " .. tostring(error), false)
    end
    
    -- Button Animation
    TweenService:Create(runButton, TweenInfo.new(0.1), {
        Size = UDim2.new(0.45, 0, 0.9, 0)
    }):Play()
    task.wait(0.1)
    TweenService:Create(runButton, TweenInfo.new(0.1), {
        Size = UDim2.new(0.48, 0, 1, 0)
    }):Play()
end)

