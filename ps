    if tabName == "Home" then HomePage.Visible = true HomeTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) HomeTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    elseif tabName == "Job" then JobPage.Visible = true JobTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) JobTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
    elseif tabName == "Grief" then GriefPage.Visible = true GriefTabBtn.BackgroundColor3 = Color3.fromRGB(35,35,35) GriefTabBtn.TextColor3 = Color3.fromRGB(255,80,80)
