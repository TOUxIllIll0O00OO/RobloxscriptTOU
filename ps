-- 🎯 ฟังก์ชันหลัก
local function equipMP5()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    
    if character and backpack then
        local mp5 = backpack:FindFirstChild("MP5")
        if mp5 and mp5:IsA("Tool") then
            character.Humanoid:EquipTool(mp5)
            wait(0.1)
            return true
        end
        
        local mp5InHand = character:FindFirstChild("MP5")
        if mp5InHand then
            return true
        end
    end
    return false
end

local function unequipMP5()
    local character = LocalPlayer.Character
    if character then
        character.Humanoid:UnequipTools()
    end
end

local function executePlayer(targetPlayer)
    pcall(function()
        if targetPlayer.Character then
            local args = {"execute", targetPlayer.Character}
            KnockEvent:FireServer(unpack(args))
        end
    end)
end

-- แทนที่ฟังก์ชัน shootMP5 ทั้งหมด:

local function shootMP5(targetPlayer)
    pcall(function()
        local character = LocalPlayer.Character
        local backpack = LocalPlayer.Backpack
        
        if not character then return end
        
        local mp5 = character:FindFirstChild("MP5") or backpack:FindFirstChild("MP5")
        if not mp5 then return end

        local targetCharacter = targetPlayer.Character
        if not targetCharacter then return end
        
        local humanoid = targetCharacter:FindFirstChild("Humanoid")
        local leftHand = targetCharacter:FindFirstChild("LeftHand")
        local targetHRP = targetCharacter:FindFirstChild("HumanoidRootPart")
        
        local targetPart = leftHand or targetHRP
        
        if humanoid and targetPart and humanoid.Health > 15 then
            local myHRP = character:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end
            
            -- คำนวณระยะทางและทิศทาง
            local distance = (myHRP.Position - targetPart.Position).Magnitude
            local direction = (targetPart.Position - myHRP.Position).Unit
            
            -- 1. Fire WeaponFired ก่อน (ยิงปืนออก)
            local fireArgs = {
                mp5,
                {
                    id = math.random(1, 100),
                    charge = 0,
                    origin = myHRP.Position,
                    dir = direction
                }
            }
            
            WeaponsSystem:WaitForChild("Network"):WaitForChild("WeaponFired"):FireServer(unpack(fireArgs))
            
            wait(0.05) -- รอนิดนึง
            
            -- 2. Fire WeaponHit (ตรวจสอบว่ายิงโดน)
            local hitArgs = {
                mp5,
                {
                    p = targetPart.Position,
                    pid = 1,
                    part = targetPart,
                    d = distance,
                    maxDist = distance,
                    h = humanoid,
                    m = Enum.Material.SmoothPlastic,
                    n = direction,
                    t = tick(),
                    sid = math.random(1, 100)
                }
            }
            
            WeaponsSystem:WaitForChild("Network"):WaitForChild("WeaponHit"):FireServer(unpack(hitArgs))
        end
    end)
end

local function killAllPlayers()
    task.spawn(function()
        pcall(function()
            if not equipMP5() then return end
            
            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return end
            local originalPosition = character.HumanoidRootPart.CFrame
            
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local targetCharacter = player.Character
                    local humanoid = targetCharacter:FindFirstChild("Humanoid")
                    local hrp = targetCharacter:FindFirstChild("HumanoidRootPart")
                    
                    if humanoid and hrp then
                        local attempts = 0
                        while humanoid.Health > 15 and attempts < 100 do
                            shootMP5(player)
                            wait(0.1)
                            attempts = attempts + 1
                        end
                        
                        wait(0.2)
                        
                        if humanoid.Health <= 15 and humanoid.Health > 0 then
                            character.HumanoidRootPart.CFrame = hrp.CFrame + Vector3.new(0, 2, 0)
                            wait(0.15)
                            
                            executePlayer(player)
                            wait(0.15)
                        end
                    end
                end
            end
            
            wait(0.2)
            if character and character:FindFirstChild("HumanoidRootPart") then
                character.HumanoidRootPart.CFrame = originalPosition
            end
            
            wait(0.2)
            unequipMP5()
        end)
    end)
end

