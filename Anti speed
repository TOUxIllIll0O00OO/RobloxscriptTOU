-- LocalScript
-- วางใน StarterPlayerScripts หรือ StarterGui

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")

-- GUI
local ScreenGui = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
ScreenGui.Name = "AnimLoggerUI"

local Frame = Instance.new("Frame", ScreenGui)
Frame.Size = UDim2.new(0, 300, 0, 150)
Frame.Position = UDim2.new(0.3, 0, 0.3, 0)
Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Frame.BorderSizePixel = 0
Frame.Active = true
Frame.Draggable = true
Frame.Name = "MainFrame"

local UICorner = Instance.new("UICorner", Frame)
UICorner.CornerRadius = UDim.new(0, 10)

local Title = Instance.new("TextLabel", Frame)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Text = "🎬 Animation Logger"
Title.TextColor3 = Color3.fromRGB(0, 255, 150)
Title.Font = Enum.Font.FredokaOne
Title.TextSize = 20

local TextBox = Instance.new("TextBox", Frame)
TextBox.Size = UDim2.new(1, -20, 0, 40)
TextBox.Position = UDim2.new(0, 10, 0, 40)
TextBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBox.Text = "Animation ID จะขึ้นตรงนี้"
TextBox.Font = Enum.Font.SourceSansBold
TextBox.TextSize = 18
TextBox.ClearTextOnFocus = false

local CopyButton = Instance.new("TextButton", Frame)
CopyButton.Size = UDim2.new(0, 120, 0, 40)
CopyButton.Position = UDim2.new(0.5, -60, 1, -50)
CopyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
CopyButton.Text = "คัดลอก ID"
CopyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
CopyButton.Font = Enum.Font.FredokaOne
CopyButton.TextSize = 18

local UICornerBtn = Instance.new("UICorner", CopyButton)
UICornerBtn.CornerRadius = UDim.new(0, 8)

-- ปุ่มคัดลอก
CopyButton.MouseButton1Click:Connect(function()
	if setclipboard then
		setclipboard(TextBox.Text)
	elseif toclipboard then
		toclipboard(TextBox.Text)
	end
end)

-- ฟังก์ชันตรวจอนิเมชัน
local function trackAnimations()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local humanoid = char:WaitForChild("Humanoid")

	humanoid.AnimationPlayed:Connect(function(animTrack)
		local anim = animTrack.Animation
		if anim and anim.AnimationId then
			local animId = anim.AnimationId:gsub("rbxassetid://","")
			TextBox.Text = animId
		end
	end)
end

-- รันตอนเริ่ม
LocalPlayer.CharacterAdded:Connect(trackAnimations)
if LocalPlayer.Character then
	trackAnimations()
end
